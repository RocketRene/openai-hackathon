{
  "name": "voya",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.mjs",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:worker": "node --env-file-if-exists=.env scripts/prepare-worker.mjs",
    "deploy": "npm run build && npm run build:worker && wrangler deploy",
    "secrets:upload": "node --env-file-if-exists=.env scripts/upload-secrets.mjs"
  },
  "dependencies": {
    "@cloudflare/realtimekit-react": "latest",
    "@cloudflare/realtimekit-react-ui": "latest",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "wrangler": "^4.140.0"
  }
}
