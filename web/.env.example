# Copy to web/.env. Never use VITE_ prefixes for credentials.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
PORT=5173
# Optional: participant token for an existing Cloudflare interview meeting.
REALTIMEKIT_AUTH_TOKEN=
# Optional absolute path, default: ../exports/all-enriched-profiles.json
CANDIDATES_FILE=
